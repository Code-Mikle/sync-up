# Product Config
LOCAL_MYSQL_HOST=localhost
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_USERNAME=root
LOCAL_MYSQL_PASSWORD=

LOCAL_REDIS_HOST=localhost
LOCAL_REDIS_PORT=6379
LOCAL_REDIS_PASSWORD=

LOCAL_SERVER_PORT=8080

# Optional AI agent config. It is disabled by default.
SYNC_UP_AI_AGENT_ENABLED=false
SYNC_UP_AI_AGENT_MODEL=qwen3.7-max-2026-05-20
SYNC_UP_AI_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
SYNC_UP_AI_AGENT_TIMEOUT_MS=8000
SYNC_UP_AI_AGENT_MAX_TOOL_CALLS=3
SYNC_UP_AI_EMBEDDING_ENABLED=false
SYNC_UP_AI_EMBEDDING_MODEL=text-embedding-v4
SYNC_UP_AI_EMBEDDING_DIMENSIONS=1024
SYNC_UP_AI_EMBEDDING_TIMEOUT_MS=10000
SYNC_UP_AI_TEAM_EMBEDDING_INITIAL_DELAY_MS=15000
SYNC_UP_AI_TEAM_EMBEDDING_FIXED_DELAY_MS=60000
SYNC_UP_AI_TAG_EMBEDDING_INITIAL_DELAY_MS=20000
SYNC_UP_AI_TAG_EMBEDDING_FIXED_DELAY_MS=60000
SYNC_UP_AI_TAG_RESOLUTION_HIGH_CONFIDENCE_SCORE=0.72
SYNC_UP_AI_TAG_RESOLUTION_MIN_CANDIDATE_SCORE=0.60
SYNC_UP_AI_TAG_RESOLUTION_MIN_TOP_SCORE_MARGIN=0.05
SYNC_UP_AI_USER_SEARCH_MIN_SEMANTIC_SCORE=0.62
SYNC_UP_AI_MEMORY_CHAT_HISTORY_RETENTION_DAYS=365
SYNC_UP_AI_MEMORY_RECENT_MESSAGE_COUNT=20
SYNC_UP_AI_MEMORY_SUMMARY_BATCH_SIZE=10
SYNC_UP_AI_MEMORY_SUMMARY_INPUT_MAX_TOKENS=4000
SYNC_UP_AI_MEMORY_MAX_CONTEXT_TOKENS=6000
SYNC_UP_AI_MEMORY_SUMMARY_MAX_CHARS=1500
SYNC_UP_AI_MEMORY_SUMMARY_SCAN_FIXED_DELAY_MS=60000
SYNC_UP_AI_MEMORY_TASK_SCAN_FIXED_DELAY_MS=30000
SYNC_UP_AI_MEMORY_EPISODE_EXTRACTION_ENABLED=true
SYNC_UP_AI_MEMORY_EPISODE_MAX_RETRIES=3
SYNC_UP_AI_MEMORY_EPISODE_TIMEOUT_MINUTES=10
SYNC_UP_AI_MEMORY_EPISODE_TASK_BATCH_SIZE=20
SYNC_UP_AI_MEMORY_EPISODE_MESSAGE_BATCH_SIZE=100
SYNC_UP_AI_MEMORY_EPISODE_MESSAGE_BATCH_MAX_TOKENS=6000
SYNC_UP_AI_MEMORY_PROFILE_THRESHOLD=5
SYNC_UP_AI_MEMORY_PROFILE_MAX_WAIT_DAYS=7
SYNC_UP_AI_MEMORY_PROFILE_MAX_RETRIES=3
SYNC_UP_AI_MEMORY_PROFILE_TIMEOUT_MINUTES=10
SYNC_UP_AI_MEMORY_PROFILE_TASK_BATCH_SIZE=20

